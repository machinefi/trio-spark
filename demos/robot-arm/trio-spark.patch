+    def _spark_choice(self, state, spec):
+        options = spec["criteria"]
+        if not 2 <= len(options) <= 8:
+            raise ValueError("Spark requires 2..8 offered actions")
+        payload = {
+            "model": "trio-spark-preview",
+            "task": spec["instructions"] if isinstance(spec["instructions"], str) else json.dumps(spec["instructions"]),
+            "state": state,
+            "choices": [{"id": key, "description": str(value)} for key, value in options.items()],
+        }
+        response = self._post(
+            self.connection["url"], json=payload,
+            headers={"Authorization": f"Bearer {self.connection['key']}",
+                     "Idempotency-Key": str(uuid.uuid4()), "User-Agent": "Trio-Spark-Examples/1.0"},
+            timeout=25, follow_redirects=False)
+        response.raise_for_status()
+        body = response.json()
+        answer = {
+            "choice": body["choice_id"],
+            "probabilities": {row["choice_id"]: row["probability"] for row in body["probabilities"]},
+            "confidence": body.get("confidence"),
+        }
+        usage = body.get("usage") or {}
+        self.tokens += int(usage.get("billed_input_tokens", 0))
+        self.model = "Trio-Spark v1.0"
+        return answer
